# Sanity CMS Configuration
# Create a project at https://sanity.io/manage and fill in these values.
# Without them, the site uses the local static fallback in src/lib/projects.ts
# and the Studio at /studio will display a configuration error.

NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
